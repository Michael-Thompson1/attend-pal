# Attend Pal — Environment Variables
# Copy this to .env.local and fill in values after creating your Supabase project.
# NEVER commit .env.local to git.

# ── Supabase ───────────────────────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never use in client components. Never put in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=

# ── Security ───────────────────────────────────────────────────────────────
# Random 32+ character secret for hashing device IDs and IPs server-side.
# Generate with: openssl rand -base64 32
DEVICE_PEPPER_SECRET=

# ── Domain Allow-list ──────────────────────────────────────────────────────
# Comma-separated list of school email domains lecturers may register with.
ALLOWED_DOMAINS=ucc.edu.gh,stu.ucc.edu.gh,ug.edu.gh,st.ug.edu.gh,knust.edu.gh

# ── Cloudflare Turnstile ───────────────────────────────────────────────────
# From: Cloudflare dashboard → Turnstile → Your site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
